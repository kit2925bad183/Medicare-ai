# ==============================================================================
# MediCare AI - Environment Configuration Template
# Copy this file to .env before starting containers: `cp .env.example .env`
# ==============================================================================

# Application Port
HOST_PORT=8080

# Database Configuration (MySQL 8)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=medicare_root_secure_password_2026
MYSQL_DATABASE=medicare_ai
MYSQL_USER=medicare_app
MYSQL_PASSWORD=medicare_secure_app_pass_2026

# Spring Mail / SMTP Server (Defaults to internal Mailpit container)
MAIL_HOST=mailpit
MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Security & Sessions
SESSION_COOKIE_SECURE=false # Set to true when serving behind HTTPS / SSL reverse proxy
REMEMBER_ME_KEY=medicare-strong-production-random-secret-key-32chars

# JVM / Performance
DB_POOL_MAX=15
DB_POOL_MIN=5
REMINDER_POLL_DELAY_MS=30000
